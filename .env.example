# Neon (https://neon.com) — managed Postgres.
# Copy the pooled connection string (host contains -pooler).
DATABASE_URL="postgresql://USER:***@ep-YOUR-PROJECT-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection string (no -pooler), used by db:push and db:migrate.
DATABASE_URL_UNPOOLED="postgresql://USER:***@ep-YOUR-PROJECT.REGION.aws.neon.tech/DB?sslmode=require"

# Optional: token that allows deleting any comment through the API.
COMMENTS_ADMIN_TOKEN=""

# Optional: random secret used to hash the visitor identity (rate limit + views).
# Generate with: node -e "console.log(crypto.randomUUID())"
VISITOR_HASH_SECRET=""
