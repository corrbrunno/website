# Neon (https://neon.com) — Postgres em nuvem.
# Endpoint pooled: copie de Connection string com -pooler no host.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-SEU-PROJETO-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require"
# Endpoint direto (sem -pooler), usado por db:push e db:migrate.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-SEU-PROJETO.REGIAO.aws.neon.tech/BANCO?sslmode=require"

# Opcional: token que permite remover qualquer comentario via API.
COMMENTS_ADMIN_TOKEN=""

# Opcional: segredo (aleatorio) para o hash do IP no rate limit.
# Gere com: node -e "console.log(crypto.randomUUID())"
COMMENT_IP_SECRET=""
